# Alpine/musl image for the headless-keystore verification.
#
# docs/CROSS-OS.md listed musl as a known risk: "no prebuild → source build needs
# libsecret headers + toolchain; document or ship a prebuild if container use
# becomes real." With four keystore backends that risk is largely gone — keytar
# never has to load at all — so this exists to hold that claim to account.
#
# Deliberately installs NO libsecret. What is being verified is that mailman works
# on musl *without* it, not that Alpine can be made to look like Ubuntu.
FROM node:20-alpine

# bash for the shared check script; the rest of what it needs (stat -c, crontab,
# mktemp) busybox already provides.
RUN apk add --no-cache bash dcron

WORKDIR /work
COPY mailman.tgz /work/mailman.tgz
COPY run-keystore-checks.sh /work/run-keystore-checks.sh

# keytar ships a musl prebuild, so this succeeds. The binary then fails to *load*
# at runtime for want of libsecret — which is exactly the case the keystore
# backends exist to make survivable.
RUN npm install -g /work/mailman.tgz

ENTRYPOINT ["bash", "/work/run-keystore-checks.sh"]
