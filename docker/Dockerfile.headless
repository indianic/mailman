# Ubuntu image for the headless-keystore verification (docs/HEADLESS-KEYSTORE.md).
#
# One Dockerfile, three keyring states, selected with --build-arg KEYRING_LEVEL:
#
#   none       bare server — no libsecret at all. This is state 1 of the bug
#              report: `npm install -g` succeeds, then keytar cannot even LOAD
#              because it links libsecret at runtime.
#   libsecret  the library but no daemon. State 2: `libsecret` present, nothing
#              serving org.freedesktop.secrets on the bus. The state doctor used
#              to describe as "libsecret: present (keytar can reach the Secret
#              Service)" — a false claim.
#   full       libsecret + gnome-keyring + dbus-x11. A working desktop-equivalent,
#              to prove the default path is unchanged.
#
# The keyring packages are installed in a layer AFTER node, so all three tags
# share the (slow) node install from the build cache.
#
# Hermetic like Dockerfile.ubuntu: mailman comes from a locally-packed tarball,
# never from npm.indianic.in, so no registry token enters an image layer.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# NODE_MAJOR exists to test the floor `engines` claims (>=18) and a current
# release, not just whatever is convenient. scrypt's maxmem behaviour and keytar's
# N-API prebuild selection are both things that could plausibly differ by major.
ARG NODE_MAJOR=20

# `cron` is here for the ticker checks — the crontab binary is what
# installTickerIfNeeded writes through.
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates cron \
    && curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

ARG KEYRING_LEVEL=none
RUN set -eux; \
    case "$KEYRING_LEVEL" in \
      none) \
        echo "KEYRING_LEVEL=none — deliberately no libsecret (the reported bare-server state)" ;; \
      libsecret) \
        apt-get update && apt-get install -y --no-install-recommends libsecret-1-0 \
        && rm -rf /var/lib/apt/lists/* ;; \
      full) \
        apt-get update && apt-get install -y --no-install-recommends libsecret-1-0 gnome-keyring dbus-x11 \
        && rm -rf /var/lib/apt/lists/* ;; \
      *) echo "unknown KEYRING_LEVEL: $KEYRING_LEVEL" >&2; exit 1 ;; \
    esac

WORKDIR /work
COPY mailman.tgz /work/mailman.tgz
COPY run-keystore-checks.sh /work/run-keystore-checks.sh

# Global install gives us the `mailman` bin. keytar ships N-API prebuilds, so
# this succeeds even with no libsecret present — which is exactly the reported
# behaviour: the install works and only the first invocation fails.
RUN npm install -g /work/mailman.tgz

ENTRYPOINT ["bash", "/work/run-keystore-checks.sh"]
