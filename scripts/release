#!/usr/bin/env bash
###############################################################################
# release — ship the version in package.json everywhere, in one command.
#
# Runs the three destinations in the only order that is safe:
#   1. npmjs      (@integratex/mailman)   — what users actually install
#   2. GitHub     filtered mirror + tag   — public source, internal files stripped
#   3. GitHub     Release + notes         — the "Releases" page people read
#
# Every step is SKIPPED IF ALREADY DONE, so re-running after a failure resumes
# instead of starting over. That matters because an npm version can never be
# republished: if the mirror push fails at step 2, `./scripts/release` again
# picks up at step 2 rather than dying on a duplicate publish.
#
# The version is read from package.json — bump with `npm version patch` first,
# which also creates the matching git tag this script pushes.
#
# Usage:
#   ./scripts/release                # ship the current package.json version
#   ./scripts/release --dry-run      # print every step, change nothing
#   ./scripts/release --skip-npm     # mirror + Release only (npm already done)
#   ./scripts/release --skip-github  # publish to npmjs only
#
# Credentials (neither lives on this machine by default — see INTERNAL.md):
#   npmjs   — the token in ~/.npmrc expires often. The script detects it and
#             runs `npm login` for you; that needs a real terminal + browser.
#   GitHub  — set GH_TOKEN, or the script prompts (input is never echoed and
#             never written to disk). It must come from an account with write
#             access to indianic/mailman; `kalpeshgamit` is read-only, and no
#             scope can fix an access problem.
###############################################################################
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_DIR"

REGISTRY="https://registry.npmjs.org"
PUBLIC_NAME="@integratex/mailman"
REPO="indianic/mailman"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; DIM='\033[2m'; NC='\033[0m'
log()  { echo -e "\n${BLUE}==> $1${NC}"; }
ok()   { echo -e "${GREEN}  ✓ $1${NC}"; }
warn() { echo -e "${YELLOW}  ⚠ $1${NC}"; }
skip() { echo -e "${DIM}  – $1${NC}"; }
fail() { echo -e "${RED}  ✗ $1${NC}"; exit 1; }

DRY_RUN=""; SKIP_NPM=""; SKIP_GITHUB=""
for arg in "$@"; do
    case "$arg" in
        --dry-run)     DRY_RUN=1 ;;
        --skip-npm)    SKIP_NPM=1 ;;
        --skip-github) SKIP_GITHUB=1 ;;
        -h|--help)     sed -n '2,40p' "$0"; exit 0 ;;
        *)             fail "Unknown argument: $arg (try --help)" ;;
    esac
done

# Echoes the command in dry-run mode instead of running it. Used for every
# step with a side effect — publishing, pushing, creating a release.
run() {
    if [ -n "$DRY_RUN" ]; then
        echo -e "${DIM}  would run: $*${NC}"
    else
        "$@"
    fi
}

# A success line that must not be printed when nothing actually happened —
# "✓ Published to npmjs" during a dry run is exactly the kind of false
# reassurance a release script must never give.
did() { [ -n "$DRY_RUN" ] || ok "$1"; }

VERSION=$(node -p "require('./package.json').version")
TAG="v$VERSION"

echo -e "${BLUE}Releasing $PUBLIC_NAME@$VERSION${DRY_RUN:+  (dry run — nothing will change)}${NC}"

# ─── Preflight ───────────────────────────────────────────────────────────────
# All of this is cheap and all of it has bitten a release before. Checked up
# front so the script fails before publishing rather than halfway through.
log "Preflight"

if [ -n "$(git status --porcelain)" ]; then
    fail "Working tree is dirty. Commit or stash first — whatever is uncommitted
    would still be packed into the npm tarball, and the GitHub mirror would
    disagree with what users install."
fi
ok "Working tree clean"

# The tag `npm version` created must exist and be the commit we are shipping,
# or the GitHub Release would point at unrelated code.
if ! git rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then
    fail "No local tag $TAG. Bump with \`npm version patch\` (it creates the tag), then re-run."
fi
if [ "$(git rev-parse "$TAG^{commit}")" != "$(git rev-parse HEAD)" ]; then
    fail "Tag $TAG does not point at HEAD — you have commits after the version bump.
    Re-bump (\`npm version patch\`) so the tag matches what you are shipping."
fi
ok "Tag $TAG is at HEAD"

# Release notes come from the CHANGELOG section for this exact version. No
# section means the release would go out with an empty body.
NOTES_FILE="$(mktemp)"
trap 'rm -f "$NOTES_FILE"' EXIT
awk -v v="$VERSION" '$0 ~ "^## \\[" v "\\]" {f=1; next} /^## \[/ {f=0} f' CHANGELOG.md > "$NOTES_FILE"
if [ ! -s "$NOTES_FILE" ]; then
    fail "CHANGELOG.md has no '## [$VERSION]' section — add one before releasing."
fi
ok "Release notes extracted ($(grep -c . "$NOTES_FILE") lines)"

log "Build, lint, test"
npm run build > /dev/null || fail "Build failed"
npm run lint  > /dev/null || fail "Lint failed"
npm test      > /dev/null 2>&1 || fail "Tests failed"
ok "Build, lint and tests passed"

# ─── 1. npmjs ────────────────────────────────────────────────────────────────
if [ -n "$SKIP_NPM" ]; then
    log "npmjs — skipped (--skip-npm)"
else
    log "npmjs — $PUBLIC_NAME@$VERSION"

    PUBLISHED=$(npm view "$PUBLIC_NAME@$VERSION" version --registry="$REGISTRY" 2>/dev/null || true)
    if [ "$PUBLISHED" = "$VERSION" ]; then
        skip "$VERSION is already on npmjs — nothing to publish"
    else
        # An expired ~/.npmrc token reports as `E404 Not Found - PUT` on publish,
        # which reads like a missing package. Catch it here, where it's honest.
        if ! npm whoami --registry="$REGISTRY" >/dev/null 2>&1; then
            warn "Not authenticated to npmjs (the token in ~/.npmrc expires regularly)"
            if [ -n "$DRY_RUN" ]; then
                echo -e "${DIM}  would run: npm login --registry=$REGISTRY${NC}"
            elif [ -t 0 ]; then
                npm login --registry="$REGISTRY"
            else
                fail "npm login needs a real terminal (browser + 2FA). Run this script from a terminal."
            fi
        fi
        [ -n "$DRY_RUN" ] || ok "Authenticated as $(npm whoami --registry="$REGISTRY")"

        # release-public rewrites package.json to the public name for the pack
        # and restores it on every exit path. Kept as its own script so a
        # publish can still be done by hand.
        run ./scripts/release-public
        did "Published to npmjs"
    fi
fi

# ─── 2 & 3. GitHub ───────────────────────────────────────────────────────────
if [ -n "$SKIP_GITHUB" ]; then
    log "GitHub — skipped (--skip-github)"
    echo -e "\n${GREEN}Done.${NC}"
    exit 0
fi

log "GitHub — credentials"
command -v gh >/dev/null 2>&1 || fail "gh CLI not found — install it (brew install gh) or run the GitHub steps by hand."

if [ -z "${GH_TOKEN:-}" ]; then
    if [ -t 0 ]; then
        # -s: never echoed. Deliberately not cached anywhere — a release token
        # written to the repo or to git config is a token that leaks.
        read -rsp "  GitHub token with write access to $REPO: " GH_TOKEN
        echo
    else
        fail "GH_TOKEN is not set and there is no terminal to prompt on.
    Run: GH_TOKEN=<token> ./scripts/release"
    fi
fi
[ -n "$GH_TOKEN" ] || fail "No GitHub token given."
export GH_TOKEN

# A read-only account fails later as a bare 403 that looks like a scope
# problem. It isn't — it's an access problem, and no scope will fix it.
# Captured, never echoed: on failure gh prints its error JSON to stdout, and
# splicing that into the message produced unreadable nonsense.
TOKEN_PROBLEM=""
if ! PUSH_OK=$(gh api "repos/$REPO" --jq .permissions.push 2>/dev/null); then
    TOKEN_PROBLEM="GitHub rejected that token (bad credentials, or the account cannot see $REPO)."
elif [ "$PUSH_OK" != "true" ]; then
    TOKEN_PROBLEM="That token's account cannot push to $REPO (permissions.push = $PUSH_OK).
    It needs write access — a different token scope will not help."
fi
if [ -n "$TOKEN_PROBLEM" ]; then
    # A dry run is a rehearsal, often with a placeholder token; refusing to
    # show the remaining steps would defeat the point of rehearsing.
    [ -n "$DRY_RUN" ] || fail "$TOKEN_PROBLEM"
    warn "$TOKEN_PROBLEM"
else
    ok "Token has write access to $REPO"
fi

log "GitHub — mirror + tag $TAG"
# sync-github.sh rebuilds the package-only tree in a throwaway worktree and
# tags THAT filtered commit. Tagging the local commit instead would publish
# INTERNAL.md, scripts/ and docker/ to a public repo.
run ./scripts/sync-github.sh "$TAG"
did "Mirror pushed and $TAG tagged on the filtered commit"

log "GitHub — Release $TAG"
if gh release view "$TAG" --repo "$REPO" >/dev/null 2>&1; then
    skip "Release $TAG already exists — leaving it alone"
else
    # Attach the artifact downloaded FROM npm, not a local rebuild: what hangs
    # off the Release is then byte-identical to what users install.
    ASSET=""
    if [ -z "$DRY_RUN" ]; then
        TARBALL_DIR="$(mktemp -d)"
        if (cd "$TARBALL_DIR" && npm pack "$PUBLIC_NAME@$VERSION" --registry="$REGISTRY" >/dev/null 2>&1); then
            ASSET="$(find "$TARBALL_DIR" -name '*.tgz' | head -1)"
            ok "Attaching published artifact $(basename "$ASSET")"
        else
            warn "Could not download the published tarball — creating the Release without it"
        fi
    fi

    run gh release create "$TAG" --repo "$REPO" \
        --title "$TAG — MailMan" \
        --notes-file "$NOTES_FILE" \
        --latest \
        ${ASSET:+"$ASSET"}
    did "Release $TAG created"
fi

if [ -n "$DRY_RUN" ]; then
    echo -e "\n${GREEN}Dry run complete — nothing was published, pushed or created.${NC}"
    echo "  Re-run without --dry-run to ship $VERSION."
else
    echo -e "\n${GREEN}Done — $PUBLIC_NAME@$VERSION is live.${NC}"
    echo "  npm      https://www.npmjs.com/package/$PUBLIC_NAME"
    echo "  release  https://github.com/$REPO/releases/tag/$TAG"
fi
