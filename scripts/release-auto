#!/usr/bin/env bash
###############################################################################
# release-auto — run ./scripts/release with no prompts: no npm OTP, no GitHub
#                token paste.
#
# Wraps scripts/release rather than replacing it. Every preflight, skip-if-done
# and ordering guarantee in that script still applies; this only supplies the two
# credentials it would otherwise stop and ask for.
#
#   ./scripts/release-auto                # ship the current package.json version
#   ./scripts/release-auto --dry-run      # prove the credentials work, change nothing
#   ./scripts/release-auto --skip-npm     # any scripts/release flag is passed through
#
# ─── The credentials file ────────────────────────────────────────────────────
#
# Looked for in this order, first hit wins:
#
#   $MAILMAN_RELEASE_ENV                     explicit path
#   ~/.config/mailman-release/env            DEFAULT — outside the repo
#   <repo>/.release-env                      gitignored fallback
#
# Outside the repo is the default on purpose. A file in the working tree is one
# `git add -f`, one `git clean -x` that spares it, or one copied-directory away
# from being somewhere you did not intend. Nothing about the release needs it to
# live next to the code.
#
# Format (both lines required unless you pass --skip-npm / --skip-github):
#
#   NPM_TOKEN=npm_xxxxxxxx      a token that bypasses 2FA — see below
#   GH_TOKEN=ghp_xxxxxxxx       github.com/settings/tokens, needs push on indianic/mailman
#
# Create it:
#   mkdir -p ~/.config/mailman-release
#   printf 'NPM_TOKEN=%s\nGH_TOKEN=%s\n' "$npm" "$gh" > ~/.config/mailman-release/env
#   chmod 600 ~/.config/mailman-release/env
#
# ─── Why the npm token has to bypass 2FA ────────────────────────────────────
#
# `npm publish` under 2FA fails with EOTP and a browser URL, which is the whole
# reason this script exists. Only a token explicitly marked as bypassing 2FA can
# publish unattended — a "Publish" or "Read-only" classic token, and the
# web-login token in ~/.npmrc, will all still demand an OTP.
#
# Two ways to get one, both fine:
#
#   npm token create --name mailman-release --packages @integratex/mailman \
#       --packages-and-scopes-permission read-write --bypass-2fa --expires 365
#
#   ...or npmjs.com -> Access Tokens -> Generate New Token -> Classic -> Automation
#
# The CLI form asks for your password and one OTP *once*, to mint the token. That
# is the last OTP you enter; every release after it is prompt-free.
#
# npm is restricting 2FA-bypass tokens (you see the notice on every `npm login`).
# When that lands, the replacement is Trusted Publishing (OIDC) from a workflow:
# no token at all, nothing to leak, nothing to expire. Treat this script as the
# convenient path until then, not as the permanent answer.
#
# ─── What this does NOT do ──────────────────────────────────────────────────
#
# It never writes a token into ~/.npmrc, into the repo, or into any file that
# outlives the run. The npm credential is injected through a private npmrc built
# in a 0600 temp file, which is deleted on every exit path including Ctrl-C.
###############################################################################
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_DIR"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; DIM='\033[2m'; NC='\033[0m'
log()  { echo -e "\n${BLUE}==> $1${NC}"; }
ok()   { echo -e "${GREEN}  ✓ $1${NC}"; }
warn() { echo -e "${YELLOW}  ⚠ $1${NC}"; }
fail() { echo -e "${RED}  ✗ $1${NC}"; exit 1; }

REGISTRY="https://registry.npmjs.org"

# ─── Locate the credentials ──────────────────────────────────────────────────
log "Credentials"

ENV_FILE=""
for candidate in \
    "${MAILMAN_RELEASE_ENV:-}" \
    "$HOME/.config/mailman-release/env" \
    "$PROJECT_DIR/.release-env"
do
    [ -n "$candidate" ] && [ -f "$candidate" ] && { ENV_FILE="$candidate"; break; }
done

if [ -z "$ENV_FILE" ]; then
    fail "No credentials file found. Looked at:
      \$MAILMAN_RELEASE_ENV (unset or missing)
      ~/.config/mailman-release/env
      $PROJECT_DIR/.release-env

    Create the first one:
      mkdir -p ~/.config/mailman-release
      \$EDITOR ~/.config/mailman-release/env      # NPM_TOKEN=... and GH_TOKEN=...
      chmod 600 ~/.config/mailman-release/env

    See the header of this script for where each token comes from."
fi

# Same discipline the file keystore applies to the master key: a secret readable
# by other accounts on the machine is not a secret, and this is cheap to check.
MODE=$(stat -f '%Lp' "$ENV_FILE" 2>/dev/null || stat -c '%a' "$ENV_FILE" 2>/dev/null || echo "")
if [ -n "$MODE" ] && [ "$((8#$MODE & 8#077))" -ne 0 ]; then
    fail "$ENV_FILE is mode $MODE — readable by other users. Fix it: chmod 600 $ENV_FILE"
fi

# `set -a` so plain KEY=value lines become exported without needing `export` in
# the file. Sourced in a subshell-safe way: no command substitution is expected
# in a credentials file, and anything else in there is the author's own doing.
set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a
ok "Loaded $ENV_FILE (mode ${MODE:-unknown})"

WANT_NPM=1; WANT_GITHUB=1
for arg in "$@"; do
    case "$arg" in
        --skip-npm)    WANT_NPM="" ;;
        --skip-github) WANT_GITHUB="" ;;
    esac
done

# ─── npm: a private npmrc that dies with this process ────────────────────────
CLEANUP_NPMRC=""
cleanup() { [ -n "$CLEANUP_NPMRC" ] && rm -f "$CLEANUP_NPMRC"; }
trap cleanup EXIT INT TERM

if [ -n "$WANT_NPM" ]; then
    [ -n "${NPM_TOKEN:-}" ] || fail "NPM_TOKEN is not set in $ENV_FILE (needed unless you pass --skip-npm).
    It must bypass 2FA, or publish still asks for an OTP. Mint one with:
      npm token create --name mailman-release --packages @integratex/mailman \\
          --packages-and-scopes-permission read-write --bypass-2fa --expires 365"

    CLEANUP_NPMRC="$(mktemp "${TMPDIR:-/tmp}/mailman-npmrc.XXXXXX")"
    chmod 600 "$CLEANUP_NPMRC"
    # Copy the real config first so @indianic scope routing, registries and any
    # other settings still apply — replacing ~/.npmrc outright would break
    # anything in the release that touches the internal registry.
    [ -f "$HOME/.npmrc" ] && cat "$HOME/.npmrc" > "$CLEANUP_NPMRC"
    printf '//registry.npmjs.org/:_authToken=%s\n' "$NPM_TOKEN" >> "$CLEANUP_NPMRC"
    export NPM_CONFIG_USERCONFIG="$CLEANUP_NPMRC"

    # Prove the token works before scripts/release gets far enough to pack a
    # tarball. A wrong or expired token surfaces on publish as `E404 Not Found -
    # PUT`, which reads like a missing package and sends people the wrong way.
    if ! WHOAMI=$(npm whoami --registry="$REGISTRY" 2>/dev/null); then
        fail "NPM_TOKEN did not authenticate against $REGISTRY — wrong, revoked or expired.
    Mint a fresh one:
      npm token create --name mailman-release --packages @integratex/mailman \\
          --packages-and-scopes-permission read-write --bypass-2fa --expires 365
    List what you have: npm token list"
    fi
    ok "npm: authenticated as $WHOAMI (token from $ENV_FILE, never written to ~/.npmrc)"
fi

# ─── GitHub ──────────────────────────────────────────────────────────────────
if [ -n "$WANT_GITHUB" ]; then
    [ -n "${GH_TOKEN:-}" ] || fail "GH_TOKEN is not set in $ENV_FILE (needed unless you pass --skip-github)."
    export GH_TOKEN

    # scripts/release fails late and vaguely on a token that cannot push; ask
    # GitHub directly instead, and name the account so a wrong-account token is
    # obvious rather than mysterious.
    PERMS=$(GH_TOKEN="$GH_TOKEN" gh api repos/indianic/mailman \
              --jq '.permissions.push, .owner.login' 2>/dev/null | head -1 || echo "")
    LOGIN=$(GH_TOKEN="$GH_TOKEN" gh api user --jq .login 2>/dev/null || echo "unknown")
    [ "$PERMS" = "true" ] || fail "GH_TOKEN (account: $LOGIN) has no push access to indianic/mailman.
    No scope can fix an access problem — use a token from an account with write access."
    ok "GitHub: $LOGIN, push access confirmed"
fi

log "Handing off to scripts/release"
echo -e "${DIM}  ./scripts/release $*${NC}"

# NOT `exec`. exec replaces this process, so the EXIT trap never runs and the
# temp npmrc — which contains a live npm token — survives in /tmp after every
# release. Caught by checking for leftovers after a dry run. Call it normally,
# keep the exit status, and let the trap clean up.
set +e
./scripts/release "$@"
RELEASE_RC=$?
set -e
exit "$RELEASE_RC"
