#!/usr/bin/env bash
###############################################################################
# release-public — Publish the current tree to PUBLIC npmjs as @integratex/mailman
#
# The committed package.json carries the INTERNAL identity (@indianic/mailman,
# publishConfig.registry -> npm.indianic.in) so scripts/release-indianic keeps
# working. The public build is the same code under a different name, so the
# name has to be rewritten before `npm publish` packs the tarball — the code
# reads its own package.json name at runtime (editor MCP configs, the
# scheduled-send ticker, `mailman update`), and a public install that saw
# @indianic/mailman there would npx-resolve a package outsiders can't fetch.
#
# .github/workflows/npm-publish.yml did this in CI, but sync-github.sh excludes
# .github/workflows from the mirror by default, so that Action no longer exists
# on GitHub — this script is the local equivalent. Every exit path restores
# package.json, including Ctrl-C and a failed publish: a tree left renamed is
# how @indianic/mailman ends up accidentally published to the public registry.
#
# Usage:
#   ./scripts/release-public              # publish the current version
#   ./scripts/release-public --dry-run    # pack and validate, upload nothing
###############################################################################
set -euo pipefail

REGISTRY="https://registry.npmjs.org"
PUBLIC_NAME="@integratex/mailman"
PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
log()  { echo -e "${BLUE}==> $1${NC}"; }
ok()   { echo -e "${GREEN}  ✓ $1${NC}"; }
warn() { echo -e "${YELLOW}  ⚠ $1${NC}"; }
fail() { echo -e "${RED}  ✗ $1${NC}"; exit 1; }

cd "$PROJECT_DIR"

DRY_RUN=""
[ "${1:-}" = "--dry-run" ] && DRY_RUN="--dry-run"

VERSION=$(node -p "require('./package.json').version")
log "Publishing $PUBLIC_NAME@$VERSION to $REGISTRY${DRY_RUN:+ (dry run)}"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Checked first: everything below is wasted work if the token is stale, and a
# stale token fails as a confusing `E404 ... PUT` on publish, not a 401.
if ! WHOAMI=$(npm whoami --registry="$REGISTRY" 2>/dev/null); then
    fail "Not authenticated to $REGISTRY.
    Run \`npm login --registry=$REGISTRY\` (browser flow), then re-run this script.
    An expired //registry.npmjs.org/:_authToken in ~/.npmrc fails here too — npm
    reports it on publish as \`E404 Not Found - PUT\`, not as an auth error."
fi
ok "Authenticated as: $WHOAMI"

if [ -n "$(git status --porcelain)" ]; then
    warn "Working tree is dirty — publishing it as-is"
fi

# ─── Quality gate ────────────────────────────────────────────────────────────
log "Build, lint, test..."
npm run build  > /dev/null || fail "Build failed"
npm run lint   > /dev/null || fail "Lint failed"
npm test       > /dev/null 2>&1 || fail "Tests failed"
ok "Build, lint and tests passed"

# ─── Publish under the public name ───────────────────────────────────────────
# The trap is the whole safety story: package.json must go back to the internal
# identity no matter how this exits.
restore() { git checkout -- package.json 2>/dev/null || true; }
trap restore EXIT INT TERM

npm pkg set name="$PUBLIC_NAME"
npm pkg delete publishConfig.registry
ok "package.json rewritten to $PUBLIC_NAME (restored on exit)"

log "npm publish --access public${DRY_RUN:+ $DRY_RUN}"
# Not piped or redirected — npm's 2FA prompt needs the TTY.
npm publish --access public $DRY_RUN

restore
trap - EXIT INT TERM
ok "package.json restored to $(node -p "require('./package.json').name")"

if [ -n "$DRY_RUN" ]; then
    ok "Dry run complete — nothing was uploaded"
    exit 0
fi

# ─── Verify ──────────────────────────────────────────────────────────────────
log "Verifying the registry serves it..."
sleep 3
PUBLISHED=$(npm view "$PUBLIC_NAME" version --registry="$REGISTRY" 2>/dev/null || echo "unknown")
if [ "$PUBLISHED" = "$VERSION" ]; then
    ok "$PUBLIC_NAME@$PUBLISHED is live"
else
    warn "Registry still reports $PUBLISHED (CDN lag is normal — re-check in a minute)"
fi

echo ""
echo "Next: ./scripts/sync-github.sh   # mirror the same tree to GitHub"
